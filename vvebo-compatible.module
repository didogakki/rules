#!name= VVebo 个人页修复（兼容微博官方客户端）
#!desc= 仅处理请求 URL 中带 Weibo_intl 的 VVebo 流量；与原版模块互斥。

[Script]
Vvebo-request = type=http-request,pattern=^https:\/\/api\.weibo\.cn\/2\/(users\/show\?|statuses\/user_timeline\?).*Weibo_intl,requires-body=1,script-path=https://raw.githubusercontent.com/didogakki/rules/main/vv.js
Vvebo-response = type=http-response,pattern=^https:\/\/api\.weibo\.cn\/2\/profile\/statuses\/tab\?.*Weibo_intl.*[&?]containerid=230413\d+_-_WEIBO_SECOND_PROFILE_WEIBO,requires-body=1,script-path=https://raw.githubusercontent.com/didogakki/rules/main/vv.js

[MITM]
hostname = %INSERT% api.weibo.cn
