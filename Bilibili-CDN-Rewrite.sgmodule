#!name = 📺 Bilibili CDN Rewrite
#!desc = 哔哩哔哩：日本直连精简 CDN 重定向
#!author = VirgilClyne / customized for gakki
#!homepage = https://Redirect.BiliUniverse.io
#!icon = https://github.com/BiliUniverse/Redirect/raw/main/src/assets/icon_rounded.png
#!category = 🪐 BiliUniverse
#!version = 0.2.20-jp-direct
#!arguments = Host.OverseaVideo:"cn-hk-eq-01-01.bilivideo.com",Host.BStar:"cn-hk-eq-01-01.bilivideo.com",Host.PCDN:"cn-hk-eq-01-01.bilivideo.com",Host.MCDN:"cn-hk-eq-01-01.bilivideo.com",Storage:"Argument",LogLevel:"WARN"
#!arguments-desc = Host.OverseaVideo: 港澳台/海外视频 CDN，默认 cn-hk-eq-01-01.bilivideo.com。\nHost.BStar: 国际版 CDN，默认 cn-hk-eq-01-01.bilivideo.com。\nHost.PCDN: 中国大陆 PCDN 重定向目标，默认 cn-hk-eq-01-01.bilivideo.com。\nHost.MCDN: 中国大陆 MCDN 重定向目标，默认 cn-hk-eq-01-01.bilivideo.com；也可填 proxy-tf-all-ws.bilivideo.com 回退旧代理逻辑。\n日本直连建议优先试：cn-hk-eq-01-01.bilivideo.com、cn-hk-eq-01-03.bilivideo.com、cn-hk-eq-01-10.bilivideo.com、upos-sz-mirroraliov.bilivideo.com、upos-sz-mirrorcosov.bilivideo.com。\nStorage: 保持 Argument。\nLogLevel: WARN。

[General]
force-http-engine-hosts = %APPEND% *:4480, *:4483, *:8000, *:8082, *:9102

[Script]
📺 Bilibili CDN Rewrite JP.CDN.upgcxcode.m4s = type=http-request, pattern=^https?:\/\/.+\.bilivideo\.com\/upgcxcode\/, script-path=https://raw.githubusercontent.com/didogakki/rules/main/bilibili-cdn-rewrite.js, argument=Host.OverseaVideo="{{{Host.OverseaVideo}}}"&Host.BStar="{{{Host.BStar}}}"&Host.PCDN="{{{Host.PCDN}}}"&Host.MCDN="{{{Host.MCDN}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
📺 Bilibili CDN Rewrite JP.MCDN.v1.resource.m4s = type=http-request, pattern=^https?:\/\/[adbcefxy0-9]+\.mcdn\.bilivideo\.cn(:(8000|8082))?\/v1\/resource\/, script-path=https://raw.githubusercontent.com/didogakki/rules/main/bilibili-cdn-rewrite.js, argument=Host.OverseaVideo="{{{Host.OverseaVideo}}}"&Host.BStar="{{{Host.BStar}}}"&Host.PCDN="{{{Host.PCDN}}}"&Host.MCDN="{{{Host.MCDN}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
📺 Bilibili CDN Rewrite JP.MCDN.upgcxcode.m4s = type=http-request, pattern=^https?:\/\/[adbcefxy0-9]+\.mcdn\.bilivideo\.cn(:(4483|9102))?\/upgcxcode\/, script-path=https://raw.githubusercontent.com/didogakki/rules/main/bilibili-cdn-rewrite.js, argument=Host.OverseaVideo="{{{Host.OverseaVideo}}}"&Host.BStar="{{{Host.BStar}}}"&Host.PCDN="{{{Host.PCDN}}}"&Host.MCDN="{{{Host.MCDN}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
📺 Bilibili CDN Rewrite JP.PCDN.upgcxcode.m4s = type=http-request, pattern=^https?:\/\/(.+):4480\/upgcxcode\/, script-path=https://raw.githubusercontent.com/didogakki/rules/main/bilibili-cdn-rewrite.js, argument=Host.OverseaVideo="{{{Host.OverseaVideo}}}"&Host.BStar="{{{Host.BStar}}}"&Host.PCDN="{{{Host.PCDN}}}"&Host.MCDN="{{{Host.MCDN}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
📺 Bilibili CDN Rewrite JP.Akamaized.upgcxcode.m4s = type=http-request, pattern=^https?:\/\/upos-(hz|bstar1)-mirrorakam\.akamaized\.net\/upgcxcode\/, script-path=https://raw.githubusercontent.com/didogakki/rules/main/bilibili-cdn-rewrite.js, argument=Host.OverseaVideo="{{{Host.OverseaVideo}}}"&Host.BStar="{{{Host.BStar}}}"&Host.PCDN="{{{Host.PCDN}}}"&Host.MCDN="{{{Host.MCDN}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"

[MITM]
hostname = %APPEND% *.mcdn.bilivideo.cn, *.bilivideo.com, upos-*-mirrorakam.akamaized.net
