#!name = 📺 Bilibili CDN Rewrite
#!desc = 哔哩哔哩：日本直连精简 CDN 重定向
#!author = VirgilClyne / customized for gakki
#!homepage = https://Redirect.BiliUniverse.io
#!icon = https://github.com/BiliUniverse/Redirect/raw/main/src/assets/icon_rounded.png
#!category = 🪐 BiliUniverse
#!version = 0.2.20-jp-direct
#!arguments = Host.OverseaVideo:"cn-hk-eq-01-01.bilivideo.com",Host.BStar:"cn-hk-eq-01-01.bilivideo.com",Host.PCDN:"cn-hk-eq-01-01.bilivideo.com",Host.MCDN:"cn-hk-eq-01-01.bilivideo.com",Storage:"Argument",LogLevel:"WARN"
#!arguments-desc = Host.OverseaVideo: 日本直连优先使用香港 Equinix CDN，默认 cn-hk-eq-01-01.bilivideo.com。\nHost.BStar: 默认 cn-hk-eq-01-01.bilivideo.com。\nHost.PCDN: 默认 cn-hk-eq-01-01.bilivideo.com。\nHost.MCDN: 默认 cn-hk-eq-01-01.bilivideo.com；本定制脚本已保留 proxy-tf-all-ws 旧代理回退逻辑。\nStorage: 保持 Argument，直接使用模块参数。\nLogLevel: WARN。

[General]
force-http-engine-hosts = %APPEND% *:4480, *:4483, *:8000, *:8082, *:9102

[Script]
📺 Bilibili CDN Rewrite JP.CDN.upgcxcode.m4s = type=http-request, pattern=^https?:\/\/.+\.bilivideo\.com\/upgcxcode\/, script-path=https://raw.githubusercontent.com/didogakki/rules/main/bilibili-cdn-rewrite.js, argument=Host.OverseaVideo=cn-hk-eq-01-01.bilivideo.com&Host.BStar=cn-hk-eq-01-01.bilivideo.com&Host.PCDN=cn-hk-eq-01-01.bilivideo.com&Host.MCDN=cn-hk-eq-01-01.bilivideo.com&Storage=Argument&LogLevel=WARN
📺 Bilibili CDN Rewrite JP.MCDN.v1.resource.m4s = type=http-request, pattern=^https?:\/\/[adbcefxy0-9]+\.mcdn\.bilivideo\.cn(:(8000|8082))?\/v1\/resource\/, script-path=https://raw.githubusercontent.com/didogakki/rules/main/bilibili-cdn-rewrite.js, argument=Host.OverseaVideo=cn-hk-eq-01-01.bilivideo.com&Host.BStar=cn-hk-eq-01-01.bilivideo.com&Host.PCDN=cn-hk-eq-01-01.bilivideo.com&Host.MCDN=cn-hk-eq-01-01.bilivideo.com&Storage=Argument&LogLevel=WARN
📺 Bilibili CDN Rewrite JP.MCDN.upgcxcode.m4s = type=http-request, pattern=^https?:\/\/[adbcefxy0-9]+\.mcdn\.bilivideo\.cn(:(4483|9102))?\/upgcxcode\/, script-path=https://raw.githubusercontent.com/didogakki/rules/main/bilibili-cdn-rewrite.js, argument=Host.OverseaVideo=cn-hk-eq-01-01.bilivideo.com&Host.BStar=cn-hk-eq-01-01.bilivideo.com&Host.PCDN=cn-hk-eq-01-01.bilivideo.com&Host.MCDN=cn-hk-eq-01-01.bilivideo.com&Storage=Argument&LogLevel=WARN
📺 Bilibili CDN Rewrite JP.PCDN.upgcxcode.m4s = type=http-request, pattern=^https?:\/\/(.+):4480\/upgcxcode\/, script-path=https://raw.githubusercontent.com/didogakki/rules/main/bilibili-cdn-rewrite.js, argument=Host.OverseaVideo=cn-hk-eq-01-01.bilivideo.com&Host.BStar=cn-hk-eq-01-01.bilivideo.com&Host.PCDN=cn-hk-eq-01-01.bilivideo.com&Host.MCDN=cn-hk-eq-01-01.bilivideo.com&Storage=Argument&LogLevel=WARN
📺 Bilibili CDN Rewrite JP.Akamaized.upgcxcode.m4s = type=http-request, pattern=^https?:\/\/upos-(hz|bstar1)-mirrorakam\.akamaized\.net\/upgcxcode\/, script-path=https://raw.githubusercontent.com/didogakki/rules/main/bilibili-cdn-rewrite.js, argument=Host.OverseaVideo=cn-hk-eq-01-01.bilivideo.com&Host.BStar=cn-hk-eq-01-01.bilivideo.com&Host.PCDN=cn-hk-eq-01-01.bilivideo.com&Host.MCDN=cn-hk-eq-01-01.bilivideo.com&Storage=Argument&LogLevel=WARN

[MITM]
hostname = %APPEND% *.mcdn.bilivideo.cn, *.bilivideo.com, upos-*-mirrorakam.akamaized.net
