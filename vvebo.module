#!name= Vvebo 个人页修复


[Script]
Vvebo-request = type=http-request,pattern=^https:\/\/api\.weibo\.cn\/2\/(users\/show\?|statuses\/user_timeline\?),requires-body=1,script-path=https://raw.githubusercontent.com/didogakki/rules/main/vv.js?token=GHSAT0AAAAAACRLI5AYJWQT5DD7HLBI3VHYZUJMF2Q

Vvebo_response = type=http-response,pattern=^https:\/\/api\.weibo\.cn\/2\/profile\/statuses\/tab\?,requires-body=1,script-path=https://raw.githubusercontent.com/didogakki/rules/main/vv.js?token=GHSAT0AAAAAACRLI5AYJWQT5DD7HLBI3VHYZUJMF2Q

[MITM]
hostname = %INSERT% api.weibo.cn
